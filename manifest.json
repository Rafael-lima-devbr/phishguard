{
  "manifest_version": 3,
  "name": "PhishGuard MVP",
  "version": "0.2.0",
  "description": "Analisa links localmente antes da navegação e alerta sobre URLs suspeitas.",
  "action": {
    "default_title": "Abrir testes do PhishGuard",
    "default_popup": "test.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["analysis.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
